{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "final_class": false,
        "ordered_imports": {
            "sort_algorithm": "alpha",
            "imports_order": ["class", "function", "const"]
        }
    },
    "exclude": [
        "build",
        "vendor",
        "tests/consumers",
        "tests/laravel",
        "tests/postgres",
        "packages/tenant-laravel/tests/Boundary",
        "packages/tenant-laravel/tests/Codec",
        "packages/tenant-laravel/tests/Compatibility",
        "packages/tenant-laravel/tests/Facilities",
        "packages/tenant-laravel/tests/Http",
        "packages/tenant-laravel/tests/Queue"
    ]
}
