{
    "name": "axiomasoft/tenant-laravel",
    "description": "Guarded Laravel facilities for the Tenant runtime.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.4 <8.6",
        "ext-intl": "*",
        "ext-posix": "*",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/tenant": "^1.0",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/session": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "laravel/framework": "^12.0 || ^13.0",
        "league/flysystem-local": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Tenant\\Laravel\\": "src/"
        },
        "files": [
            "src/aliases.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tenant\\Laravel\\TenantServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "addon",
            "stability": "stable",
            "error-prefix": "tenant",
            "owns": [
                "Codec",
                "Configuration",
                "Contracts",
                "Data",
                "Diagnostics",
                "Http",
                "Internal",
                "Laravel",
                "Queue",
                "Registrars"
            ]
        }
    }
}
